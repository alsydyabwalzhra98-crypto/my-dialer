generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  uid       String   @unique
  email     String   @unique
  password  String?
  name      String?
  balance   Float    @default(1.0)
  assignedUSNumber String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts Contact[]
  logs     CallLog[]
  messages Message[]
}

model Contact {
  id        String  @id @default(cuid())
  userId    String
  userUid   String
  name      String
  number    String
  favorite  Boolean @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CallLog {
  id           String   @id @default(cuid())
  userId       String
  userUid      String
  to           String
  type         String   // "outgoing" or "incoming"
  cost         Float    @default(0)
  duration     Int      @default(0)
  recordingUrl String?
  date         DateTime @default(now())
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Message {
  id        String   @id @default(cuid())
  userId    String
  userUid   String
  number    String
  name      String?
  text      String
  type      String   // "sent" or "received"
  timestamp Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id        String   @id @default(cuid())
  userUid   String
  amount    Float
  type      String   // "topup", "call", "transfer"
  date      DateTime @default(now())
}
